# SQLite database file, relative to prisma/schema.prisma (i.e. ./db/custom.db).
# For the production (standalone) build, an absolute path is recommended,
# e.g. DATABASE_URL=file:/home/lab/GazeStroop/db/custom.db
DATABASE_URL=file:../db/custom.db

# Secret used to sign administrator session tokens (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me

# Optional: WebSocket URL of gazepoint-bridge (default ws://127.0.0.1:4243).
# It can also be changed later from Admin panel -> Configuration -> Eye Tracker.
# NEXT_PUBLIC_EYETRACKER_BRIDGE_URL=ws://127.0.0.1:4243
